index 7f277fdc..2ae86e47 100644
--- a/apps/desktop/resources/installer.nsh
+++ b/apps/desktop/resources/installer.nsh
@@ -40,3 +40,61 @@
     ${EndIf}
   !endif
 !macroend
+
+; Use the exact directory entered by the user. The standard assisted page
+; unconditionally appends APP_FILENAME to many valid user-supplied names.
+!macro customPageAfterChangeDir
+  Var quotaDirectorySuggested
+
+  Function QuotaDirectoryPre
+    ${If} ${isUpdated}
+      Abort
+    ${EndIf}
+    ${If} $quotaDirectorySuggested == ""
+      StrCpy $quotaDirectorySuggested "1"
+      !insertmacro GetDParameter $R0
+      ${If} $R0 == ""
+      ${AndIf} $hasPerUserInstallation != "1"
+      ${AndIf} $hasPerMachineInstallation != "1"
+        System::Call 'kernel32::GetDriveTypeW(w "D:\") i.r0'
+        ${If} $0 == 3
+          StrCpy $INSTDIR "D:\T3Code"
+        ${EndIf}
+      ${EndIf}
+    ${EndIf}
+  FunctionEnd
+
+  ; The uninstaller removes its application directory recursively. Only adopt
+  ; an empty/new folder or the existing registered installation of this app.
+  Function QuotaValidateDirectory
+    Push $0
+    System::Call 'shlwapi::PathIsRootW(w "$INSTDIR") i.r0'
+    StrCmp $0 "0" 0 quota_invalid
+    IfFileExists "$INSTDIR\." 0 quota_valid
+    System::Call 'shlwapi::PathIsDirectoryEmptyW(w "$INSTDIR") i.r0'
+    StrCmp $0 "0" 0 quota_valid
+    ReadRegStr $0 SHCTX "${INSTALL_REGISTRY_KEY}" "InstallLocation"
+    StrCmp $0 "$INSTDIR" 0 quota_invalid
+    IfFileExists "$INSTDIR\${APP_EXECUTABLE_FILENAME}" quota_valid quota_invalid
+    quota_invalid:
+      Pop $0
+      ${If} ${Silent}
+        SetErrorLevel 2
+        Quit
+      ${EndIf}
+      MessageBox MB_OK|MB_ICONEXCLAMATION "请选择专用的空文件夹或已有的 T3 Code Quota UI 安装目录。$\r$\nChoose an empty folder or the existing T3 Code Quota UI installation."
+      Abort
+    quota_valid:
+      Pop $0
+  FunctionEnd
+
+  !define MUI_PAGE_CUSTOMFUNCTION_PRE QuotaDirectoryPre
+  !define MUI_PAGE_CUSTOMFUNCTION_LEAVE QuotaValidateDirectory
+  !insertmacro MUI_PAGE_DIRECTORY
+!macroend
+
+!macro customInit
+  ${If} ${Silent}
+    Call QuotaValidateDirectory
+  ${EndIf}
+!macroend
